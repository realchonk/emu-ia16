NAME = cpp
OBJS = cpp.o cpy.o
YACC = $./emu/emu $./bin/yacc/yacc

CFLAGS	+= -g -O0 -Wno-implicit-function-declaration -Wno-char-subscripts
CFLAGS	+= -Wno-comment -Wno-implicit-int -Wno-return-type -Wno-missing-parameter-type
CFLAGS	+= -DFLEXNAMES -DBSD2_86 -Di286=1 -Dunix

cpy.o: ../yacc/yacc cpy.y yylex.c
	${YACC} cpy.y
	${CC} -c -o $@ y.tab.c ${CFLAGS}
	rm -f y.tab.c

clean-extra:
	rm -f y.tab.c

.expand prog
