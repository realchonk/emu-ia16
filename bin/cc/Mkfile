NAME = cc
OBJS = cc.o

CFLAGS += -DPREFIX=\"$./_install\"
CFLAGS += -DINCDIR=\"$./lib/libc/include\"
CFLAGS += -DCPP=\"$./lib/cpp/cpp\"
CFLAGS += -DC0=\"$./lib/c0/c0\"
CFLAGS += -DC1=\"$./lib/c1/c1\"
CFLAGS += -DC2=\"$./lib/c2/c2\"
CFLAGS += -DC3A=\"$./lib/c3/c3a\"
CFLAGS += -DC3B=\"$./lib/c3/c3b\"
CFLAGS += -DC4=\"$./lib/c4/c4\"
CFLAGS += -DLD=\"$./bin/ld/ld\"
CFLAGS += -DCRT0=\"$./lib/crt0.o\"
CFLAGS += -DLIBC=\"$./lib/libc/libc.a\"
CFLAGS += -DAS=\"$./bin/as/as\"

RDEPS = $./lib/cpp $./lib/c0 $./lib/c1 $./lib/c2 $./lib/c3 $./lib/c4 $./bin/ld $./bin/as

run: ${RDEPS} cc
	${EMU} ./cc -o test test.c
	${EMU} ./test


clean-extra:
	rm -f *.i *.ast *.str *.sym *.ssa *.opt *.alc *.tmp *.mdi *.asm test test.o

.expand prog
