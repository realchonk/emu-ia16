NAME = cc
OBJS = cc.o

CFLAGS += -DPREFIX=\"$./_install\"
CFLAGS += -DINCDIR=\"$./lib/libc/include\"
CFLAGS += -DCPP=\"$./lib/cpp/cpp\"
CFLAGS += -DC0=\"$./lib/c0/c0\"
CFLAGS += -DC1=\"$./lib/c1/c1\"
CFLAGS += -DC2=\"$./lib/c2/c2\"
CFLAGS += -DC3=\"$./lib/c3/c3\"
CFLAGS += -DC4=\"$./lib/c4/c4\"

RDEPS = $./lib/cpp $./lib/c0 $./lib/c1 $./lib/c2 $./lib/c3 $./lib/c4

run: ${RDEPS} cc
	${EMU} ./cc test.c -k
	$./xcc -o test test.o
	${EMU} ./test


clean-extra:
	rm -f *.i *.ast *.str *.sym *.ssa *.opt *.tmp *.mdi *.asm test test.o

.expand prog
