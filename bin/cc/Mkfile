NAME = cc
OBJS = cc.o

CFLAGS += -DPREFIX=\"$./_install\"
CFLAGS += -DINCDIR=\"$./lib/libc/include\"
CFLAGS += -DCPP=\"$./lib/cpp/cpp\"
CFLAGS += -DC0=\"$./lib/c0/c0\"
CFLAGS += -DC1=\"$./lib/c1/c1\"
CFLAGS += -DC3=\"$./lib/c3/c3\"

ARGS ?= cc.c -k
RDEPS = $./lib/cpp $./lib/c0 $./lib/c1 $./lib/c3

clean-extra:
	rm -f *.i *.ast *.str *.sym *.ssa *.tmp

.expand prog
