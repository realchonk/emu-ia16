NAME = cpp
OBJS = cpp.o cpy.o
YACC = ${EMU} ${.OBJDIR}/$./bin/yacc/yacc

CFLAGS	+= -Wno-implicit-function-declaration -Wno-char-subscripts
CFLAGS	+= -Wno-comment -Wno-implicit-int -Wno-return-type -Wno-missing-parameter-type
CFLAGS	+= -DFLEXNAMES -DBSD2_86 -Di286=1 -Dunix

# TODO: fix warnings and remove this:
CFLAGS	+= -w

cpy.o: $./bin/yacc/yacc $./emu/emu cpy.y yylex.c
	${YACC} cpy.y
	${CC} -c -o $@ y.tab.c ${CFLAGS}
	rm -f y.tab.c

clean-extra:
	rm -f y.tab.c

.expand prog
